<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace></RootNamespace>
    <AssemblyName>StatLab</AssemblyName>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PublishSingleFile>false</PublishSingleFile>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Description>StatLab — Nonparametric Statistical Tests Laboratory (VB.NET + Web)</Description>
    <Authors>StatLab Contributors</Authors>
    <Version>2.0.0</Version>
  </PropertyGroup>

  <!-- Desktop contains an archived copy of the project. Exclude it from the
       SDK's recursive default compile globs so those files are not compiled
       alongside the active source files in the repository root. -->
  <ItemGroup>
    <Compile Remove="Desktop\**" />
    <EmbeddedResource Remove="Desktop\**" />
    <Content Remove="Desktop\**" />
    <None Remove="Desktop\**" />
    <Content Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
